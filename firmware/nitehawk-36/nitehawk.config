# Klipper firmware build config: LDO Nitehawk-36 (RP2040), USB, no bootloader
# Minimal: `make olddefconfig` fills in every other option with Klipper's defaults.
# INITIAL_PINS holds the hotend heater (gpio9) low from power-on.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_RPXXXX=y
CONFIG_MACH_RP2040=y
CONFIG_RPXXXX_FLASH_START_0100=y
CONFIG_RP2040_FLASH_W25Q080=y
CONFIG_RPXXXX_USB=y
CONFIG_INITIAL_PINS="!gpio9"
